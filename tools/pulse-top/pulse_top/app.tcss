/* Colours come from the active Textual theme (issue #59): pulse-dark, pulse-light, or
   ansi-dark for --theme terminal, which paints nothing over the terminal's own colours. */
Screen {
    background: $background;
    color: $foreground;
}

#topbar {
    height: 1;
    padding: 0 2;
    background: $panel;
    /* One line, cut at the end: a long $TMPDIR glob used to wrap and push the file
       count off the visible line. */
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#notice {
    height: auto;
    padding: 0 2;
    background: $panel;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    background: $surface;
}

Tab {
    color: $text-muted;
}

Tab.-active {
    color: $primary;
    text-style: bold;
}

/* Focused tab bar: the active tab sits on the block cursor, which is $primary. A
   $primary label on it was invisible, so it takes the cursor's own foreground. */
Tabs:focus Tab.-active {
    color: $block-cursor-foreground;
}

#table-col {
    width: 1fr;
}

#table {
    height: 1fr;
    background: $background;
}

DataTable > .datatable--header {
    background: $background;
    color: $text-muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary 20%;
}

#warns-strip {
    height: auto;
    max-height: 6;
    padding: 0 2;
    border-top: solid $border-blurred;
    background: $surface;
}

#sidebar {
    width: 32;
    padding: 1 2;
    border-left: solid $border-blurred;
    background: $surface;
}

#ns-tree, #nodes-list, #warns-list {
    padding: 1 2;
    background: $background;
}

Footer {
    background: $panel;
}
